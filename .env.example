# Copy this file to .env.local (local development) and set the same variables
# in the Vercel project settings (deployment). Never commit .env.local.
#
# The server refuses to start, with a message naming the problem, if a
# REQUIRED variable is missing or malformed (see lib/env.ts).
#
# Organisation settings (name, logo, branches, departments, modules, colours)
# are NOT environment variables - they live in config/org.config.ts.

# ----------------------------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------------------------

# Neon Postgres connection string (the pooled connection is recommended).
# Neon dashboard -> Connection Details. Must start with postgres:// or postgresql://.
# Used by the app, `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL=postgres://user:password@ep-example-12345.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign the login session cookie (HS256), at least 32 characters.
# Generate one with: openssl rand -base64 32
# Changing it signs everybody out.
AUTH_SECRET=

# Vercel Blob read/write token (attachments are stored in a private Blob store).
# Vercel dashboard -> Storage -> your Blob store -> .env.local tab.
BLOB_READ_WRITE_TOKEN=

# ----------------------------------------------------------------------------
# EMAIL (optional - defaults to preview mode, which sends nothing)
# ----------------------------------------------------------------------------

# "preview" (default if unset): emails are rendered and logged to the server
# console only, never sent. "live": really send via EMAIL_PROVIDER below.
EMAIL_MODE=preview

# "gmail" (default if unset) or "resend". Only matters when EMAIL_MODE=live.
EMAIL_PROVIDER=gmail

# gmail provider (EMAIL_MODE=live): the sending Gmail account, and a 16-character
# App Password from https://myaccount.google.com/apppasswords (needs 2-Step
# Verification) - NOT the account's normal password. GMAIL_USER is also the
# "from" address.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# resend provider (EMAIL_MODE=live): API key from the Resend dashboard, and the
# sender address on a domain you have verified in Resend. If EMAIL_FROM is unset,
# Resend's shared test sender (onboarding@resend.dev) is used.
RESEND_API_KEY=
EMAIL_FROM=

# While testing with EMAIL_MODE=live: redirect EVERY email to this address
# instead of the real recipient (subject gets a "[TEST - would go to: ...]"
# prefix). Leave empty in production.
EMAIL_TEST_OVERRIDE_RECIPIENT=

# ----------------------------------------------------------------------------
# OPTIONAL
# ----------------------------------------------------------------------------

# Gemini invoice auto-fill for Payment Advice tax invoices. Create a key in
# Google AI Studio. If unset, auto-fill is switched off and users fill the form
# manually. Server-side secret: never give it a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Only for the lib/serial.ts integration tests (`npm test`). Point it at a
# scratch Neon branch or local Postgres - NEVER at your real DATABASE_URL,
# because the tests write rows to serial_counters. Leave unset to skip them.
TEST_DATABASE_URL=

# ----------------------------------------------------------------------------
# SEED SCRIPT (`npm run db:seed`)
# ----------------------------------------------------------------------------

# Email for the demo Finance Admin login the seed creates. Defaults to
# admin@example.com; set your own address when onboarding a real organisation.
SEED_ADMIN_EMAIL=
